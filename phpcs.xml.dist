<?xml version="1.0"?>
<ruleset name="Horizon Press News Bar">
	<description>WordPress Coding Standards for the Horizon Press News Bar plugin.</description>
	<file>horizon-press-news-bar</file>
	<exclude-pattern>*/assets/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="8.0-"/>
	<rule ref="WordPress">
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="hprnb"/>
				<element value="HPRNB"/>
				<element value="HorizonPress\NewsBar"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="horizon-press-news-bar"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="strict_class_file_names" value="false"/>
		</properties>
	</rule>
</ruleset>
