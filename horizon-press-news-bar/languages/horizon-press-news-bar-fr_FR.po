#. translators: 1: minimum PHP version, 2: minimum WordPress version.
#: horizon-press-news-bar/horizon-press-news-bar.php:51
msgid "Horizon Press News Bar requires PHP %1$s or newer and WordPress %2$s or newer. The plugin has been left inactive."
msgstr "Horizon Press News Bar nécessite PHP %1$s ou plus récent et WordPress %2$s ou plus récent. L’extension est restée inactive."

#: horizon-press-news-bar/horizon-press-news-bar.php:81
#: horizon-press-news-bar/includes/class-activator.php:36
msgid "Plugin activation error"
msgstr "Erreur d’activation de l’extension"

#: horizon-press-news-bar/includes/admin/class-admin.php:55
#: horizon-press-news-bar/includes/admin/class-admin.php:56
#: horizon-press-news-bar/includes/admin/class-post-controls.php:72
msgid "News Bar"
msgstr "Barre d’actualités"

#: horizon-press-news-bar/includes/admin/class-admin.php:127
msgid "Reset every setting of this tab to its default value? Nothing is saved until you click Save."
msgstr "Réinitialiser tous les réglages de cet onglet à leur valeur par défaut ? Rien n’est enregistré tant que vous ne cliquez pas sur Enregistrer."

#: horizon-press-news-bar/includes/admin/class-admin.php:128
msgid "Restore every setting to its default value? This cannot be undone."
msgstr "Restaurer tous les réglages à leur valeur par défaut ? Cette action est irréversible."

#: horizon-press-news-bar/includes/admin/class-admin.php:129
msgid "Refreshing the preview…"
msgstr "Actualisation de l’aperçu…"

#: horizon-press-news-bar/includes/admin/class-admin.php:130
msgid "The preview could not be refreshed."
msgstr "L’aperçu n’a pas pu être actualisé."

#: horizon-press-news-bar/includes/admin/class-admin.php:131
msgid "Preview updated."
msgstr "Aperçu actualisé."

#. translators: %s: contrast ratio, e.g. "3.1:1".
#: horizon-press-news-bar/includes/admin/class-admin.php:133
msgid "Low contrast (%s). WCAG AA recommends at least 4.5:1 for text."
msgstr "Contraste faible (%s). Les WCAG AA recommandent au moins 4,5:1 pour le texte."

#: horizon-press-news-bar/includes/admin/class-admin.php:177
msgid "Settings imported."
msgstr "Réglages importés."

#: horizon-press-news-bar/includes/admin/class-admin.php:181
msgid "Settings imported. The file contains category, tag or post IDs: check that they exist on this site, IDs differ between sites."
msgstr "Réglages importés. Le fichier contient des identifiants de catégories, d’étiquettes ou d’articles : vérifiez qu’ils existent sur ce site, les identifiants diffèrent d’un site à l’autre."

#: horizon-press-news-bar/includes/admin/class-admin.php:185
msgid "Import failed: no file was received or the upload failed."
msgstr "Import impossible : aucun fichier reçu ou téléversement en échec."

#: horizon-press-news-bar/includes/admin/class-admin.php:189
msgid "Import failed: the file exceeds 256 KB."
msgstr "Import impossible : le fichier dépasse 256 Ko."

#: horizon-press-news-bar/includes/admin/class-admin.php:193
msgid "Import failed: only .json files are accepted."
msgstr "Import impossible : seuls les fichiers .json sont acceptés."

#: horizon-press-news-bar/includes/admin/class-admin.php:197
msgid "Import failed: the file is not valid JSON."
msgstr "Import impossible : le fichier n’est pas un JSON valide."

#: horizon-press-news-bar/includes/admin/class-admin.php:201
msgid "Import failed: the file is not a Horizon Press News Bar export or its schema version is not supported."
msgstr "Import impossible : le fichier n’est pas un export Horizon Press News Bar ou sa version de schéma n’est pas prise en charge."

#: horizon-press-news-bar/includes/admin/class-admin.php:205
msgid "Settings restored to their defaults."
msgstr "Réglages restaurés à leurs valeurs par défaut."

#: horizon-press-news-bar/includes/admin/class-admin.php:209
msgid "Reset cancelled: tick the confirmation box first."
msgstr "Réinitialisation annulée : cochez d’abord la case de confirmation."

#: horizon-press-news-bar/includes/admin/class-admin.php:213
#: horizon-press-news-bar/includes/admin/class-import-export.php:189
#: horizon-press-news-bar/includes/admin/class-settings-page.php:161
msgid "You are not allowed to do this."
msgstr "Vous n’avez pas l’autorisation de faire cela."

#: horizon-press-news-bar/includes/admin/class-admin.php:228
msgid "Settings"
msgstr "Réglages"

#: horizon-press-news-bar/includes/admin/class-post-controls.php:112
msgid "Never show the bar on this page"
msgstr "Ne jamais afficher la barre sur cette page"

#: horizon-press-news-bar/includes/admin/class-post-controls.php:114
msgid "Visitors reading this page see no bar at all, whatever the page types allow."
msgstr "Les visiteurs de cette page ne voient aucune barre, quels que soient les types de pages autorisés."

#: horizon-press-news-bar/includes/admin/class-post-controls.php:120
msgid "Never list this article in the bar"
msgstr "Ne jamais lister cet article dans la barre"

#: horizon-press-news-bar/includes/admin/class-post-controls.php:122
msgid "The headline is left out of the bar everywhere on the site. The two options are independent."
msgstr "Le titre est exclu de la barre sur tout le site. Les deux options sont indépendantes."

#. translators: %s: contrast ratio, e.g. "3.1:1".
#: horizon-press-news-bar/includes/admin/class-settings-page.php:71
msgid "Text / background contrast is %s, below the 4.5:1 recommended by WCAG AA."
msgstr "Le contraste texte / fond est de %s, sous le 4,5:1 recommandé par les WCAG AA."

#. translators: %s: contrast ratio, e.g. "3.1:1".
#: horizon-press-news-bar/includes/admin/class-settings-page.php:76
msgid "Label text / label background contrast is %s, below the 4.5:1 recommended by WCAG AA."
msgstr "Le contraste texte du label / fond du label est de %s, sous le 4,5:1 recommandé par les WCAG AA."

#. translators: %s: contrast ratio, e.g. "3.1:1".
#: horizon-press-news-bar/includes/admin/class-settings-page.php:82
msgid "Mobile text / mobile background contrast is %s, below the 4.5:1 recommended by WCAG AA."
msgstr "Le contraste texte mobile / fond mobile est de %s, sous le 4,5:1 recommandé par les WCAG AA."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:87
msgid "Settings saved."
msgstr "Réglages enregistrés."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:151
msgid "No post matches these criteria. The bar will not be displayed on the site."
msgstr "Aucun article ne correspond à ces critères. La barre ne sera pas affichée sur le site."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:170
msgid "Horizon Press News Bar"
msgstr "Horizon Press News Bar"

#. translators: %s: plugin version.
#: horizon-press-news-bar/includes/admin/class-settings-page.php:171
msgid "version %s"
msgstr "version %s"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:174
msgid "Reset this tab"
msgstr "Réinitialiser l’onglet"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:175
msgid "Save"
msgstr "Enregistrer"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:181
msgid "Settings sections"
msgstr "Sections des réglages"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:189
msgid "Save settings"
msgstr "Enregistrer les réglages"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:208
msgid "Content"
msgstr "Contenu"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:211
msgid "General"
msgstr "Général"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:216
msgid "Which articles"
msgstr "Quels articles"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:217
msgid "Posts are selected when they are published, inside the sliding time window (never \"since midnight\") and match the filters below. Only the publication date counts, never the modification date."
msgstr "Les articles sont sélectionnés s’ils sont publiés, dans la fenêtre temporelle glissante (jamais « depuis minuit ») et s’ils correspondent aux filtres ci-dessous. Seule la date de publication compte, jamais la date de modification."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:221
msgid "A rolling \"breaking news\" bar"
msgstr "Une barre « dernière minute » en continu"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:222
msgid "Time window 6 hours, 5 posts, newest first. Outside busy hours the bar empties itself and nothing is rendered at all."
msgstr "Fenêtre de 6 heures, 5 articles, du plus récent au plus ancien. Hors des heures chargées la barre se vide d’elle-même et plus rien n’est affiché."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:225
msgid "One section only"
msgstr "Une seule rubrique"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:226
msgid "Pick that category under Categories and widen the window to 48 hours, so the bar is never empty on a slow section."
msgstr "Choisissez cette catégorie sous Catégories et élargissez la fenêtre à 48 heures, pour que la barre ne soit jamais vide sur une rubrique peu active."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:229
msgid "Everything except one article"
msgstr "Tout sauf un article"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:230
msgid "Leave the filters open and tick \"Never list this article in the bar\" in the News Bar box on that article's edit screen."
msgstr "Laissez les filtres ouverts et cochez « Ne jamais lister cet article dans la barre » dans le bloc Barre d’actualités de l’écran d’édition de cet article."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:235
msgid "Headline details"
msgstr "Détails des titres"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:241
msgid "Where"
msgstr "Où"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:244
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1118
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1163
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1257
msgid "Page types"
msgstr "Types de pages"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:245
msgid "The one place that decides where the bar is allowed. Everything else on this tab only narrows it further."
msgstr "Le seul endroit qui décide où la barre est autorisée. Tout le reste de cet onglet ne fait que restreindre davantage."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:249
msgid "Only on single articles"
msgstr "Uniquement sur les pages d’article"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:250
msgid "Scope: \"Only the page types ticked below\", then leave only \"Single post\" ticked. Nothing else to set anywhere."
msgstr "Portée : « Uniquement les types de pages cochés ci-dessous », puis ne laissez cochée que « Article seul ». Rien d’autre à régler ailleurs."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:253
msgid "Everywhere except the home page"
msgstr "Partout sauf sur la page d’accueil"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:254
msgid "Same scope, untick \"Front page\" and leave the other eight ticked."
msgstr "Même portée, décochez « Page d’accueil » et laissez les huit autres cochées."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:257
msgid "Articles on mobile, everywhere on desktop"
msgstr "Les articles sur mobile, partout sur ordinateur"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:258
msgid "Leave the scope on \"Everywhere\", then use \"Refine per device\" below and untick everything but \"Single post\" for mobile."
msgstr "Laissez la portée sur « Partout », puis utilisez « Affiner par appareil » ci-dessous et ne gardez que « Article seul » pour le mobile."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:263
msgid "Refine per device (optional)"
msgstr "Affiner par appareil (facultatif)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:264
msgid "Only useful when the two devices must differ. Each list narrows the page types above for that device alone; untick everything in one list and that device never shows the bar. A device is switched off altogether at the top of its own tab."
msgstr "Utile seulement si les deux appareils doivent différer. Chaque liste restreint les types de pages ci-dessus pour cet appareil uniquement ; décochez tout dans une liste et cet appareil n’affiche jamais la barre. Un appareil se désactive entièrement en haut de son propre onglet."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:268
msgid "Exceptions"
msgstr "Exceptions"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:269
msgid "For one-off pages. Each article and page also carries a \"News Bar\" box on its edit screen with the same two switches, which is usually quicker than listing IDs here."
msgstr "Pour des pages ponctuelles. Chaque article et chaque page porte aussi un bloc « Barre d’actualités » sur son écran d’édition avec les deux mêmes options, ce qui est en général plus rapide que de lister des identifiants ici."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:273
msgid "Position in the page"
msgstr "Position dans la page"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:274
msgid "Fixed keeps the bar against the edge of the screen; inside the article it is placed between two paragraphs and scrolls away with the text."
msgstr "Fixe garde la barre contre le bord de l’écran ; dans l’article elle est placée entre deux paragraphes et défile avec le texte."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:280
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1112
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1756
msgid "Mobile"
msgstr "Mobile"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:283
#: horizon-press-news-bar/includes/admin/class-settings-page.php:349
#: horizon-press-news-bar/includes/admin/class-settings-page.php:679
msgid "Design"
msgstr "Design"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:284
msgid "Under 768 px. The \"Explore More\" card is the default: a label row, the picture at the left, the headline on up to three lines and the close button in a tab above the corner. The height shown beside the line count is the height the page reserves."
msgstr "Sous 768 px. La carte « Explore More » est le défaut : une ligne d’étiquette, l’image à gauche, le titre sur trois lignes au plus et le bouton de fermeture dans un onglet au-dessus du coin. La hauteur affichée à côté du nombre de lignes est celle que la page réserve."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:289
msgid "The reference, as delivered"
msgstr "La maquette, telle quelle"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:290
msgid "\"Explore More\" card, 3 lines, 16 px font (the headline is two sizes up, 18 px), a 132 px picture, floating off: exactly the design of the mock-up, 126 px tall. \"Reset this tab\" brings every mobile setting back to it."
msgstr "Carte « Explore More », 3 lignes, police de 16 px (le titre est deux tailles au-dessus, 18 px), image de 132 px, carte non flottante : exactement le design de la maquette, 126 px de haut. « Réinitialiser l’onglet » ramène tous les réglages mobiles à cet état."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:293
msgid "A plain bold heading instead of the pill"
msgstr "Un simple titre en gras au lieu de la pastille"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:294
msgid "Label style \"Strip\": the label row becomes bold white text, like \"Explore More\" on the mock-up."
msgstr "Style d’étiquette « Bandeau » : la ligne d’étiquette devient un texte blanc en gras, comme « Explore More » sur la maquette."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:297
msgid "A discreet strip"
msgstr "Un bandeau discret"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:298
msgid "Flowing bar, one line, compact label, no picture: the smallest the bar gets while staying readable."
msgstr "Barre fluide, une ligne, étiquette compacte, sans image : le plus petit format lisible."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:303
msgid "Headlines, one after another (mobile)"
msgstr "Les titres, l’un après l’autre (mobile)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:304
msgid "The card and the flowing bar show one headline at a time and rotate through them; the interval is shared with the desktop rotate mode."
msgstr "La carte et la barre fluide montrent un titre à la fois et les font tourner ; l’intervalle est partagé avec le mode rotation de l’ordinateur."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:308
msgid "When the bar appears (mobile)"
msgstr "Moment d’apparition de la barre (mobile)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:309
msgid "Mobile decides for itself; desktop has the same choice on its own tab. Until the bar appears no space is reserved for it and it stays out of view; once it appears it stays."
msgstr "Le mobile décide pour lui-même ; l’ordinateur a le même choix sur son propre onglet. Tant que la barre n’apparaît pas, aucun espace ne lui est réservé et elle reste hors de vue ; une fois apparue, elle reste."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:313
msgid "Never over the text"
msgstr "Jamais sur le texte"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:314
msgid "\"Before the end of the article\" with 2 paragraphs, and the folding below set to \"Follows the reading\": the bar arrives in full at the second-to-last paragraph, folds away the moment the reader scrolls back up into the article, stays folded until that paragraph is reached again, and stays open once the article is over."
msgstr "« Avant la fin de l’article » avec 2 paragraphes, et le repli ci-dessous sur « Suit la lecture » : la barre arrive entière à l’avant-dernier paragraphe, se replie dès que le lecteur remonte dans l’article, reste repliée jusqu’à ce que ce paragraphe soit de nouveau atteint, et reste ouverte une fois l’article terminé."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:317
msgid "Once the reader is engaged"
msgstr "Une fois le lecteur engagé"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:318
msgid "Smart: it watches the article body and shows the bar at the end of the article, on a real scroll back up, or once the reader has genuinely read a while — whichever comes first."
msgstr "Intelligent : il observe le corps de l’article et affiche la barre à la fin de l’article, lors d’une vraie remontée, ou quand le lecteur a réellement lu un moment — au premier des trois."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:321
msgid "Seen immediately"
msgstr "Vue tout de suite"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:322
msgid "Right away, with the page. The most visible, and the most likely to be ignored as an advert."
msgstr "Immédiatement, avec la page. Le plus visible, et le plus susceptible d’être ignoré comme une publicité."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:327
msgid "Folding (mobile)"
msgstr "Repli (mobile)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:328
msgid "Off, the bar keeps its full height while the reader scrolls. On, it shrinks to its label row and the first line of the headline, and a tap opens it again."
msgstr "Désactivé, la barre garde toute sa hauteur pendant le défilement. Activé, elle se réduit à sa ligne d’étiquette et à la première ligne du titre, et une pression la rouvre."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:333
msgid "Buttons (mobile)"
msgstr "Boutons (mobile)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:334
msgid "The pause and close buttons can sit inside the flowing bar or outside it. The card always carries them in its tab above the corner."
msgstr "Les boutons pause et fermer peuvent être dans la barre fluide ou à l’extérieur. La carte les porte toujours dans son onglet au-dessus du coin."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:338
msgid "Closing (both devices)"
msgstr "Fermeture (les deux appareils)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:339
msgid "A cross in the bar hides it; with the memory option the visitor does not see it again for the chosen duration (anti-flash head script). Folding and closing are independent: a folded bar is still there, a closed one is gone."
msgstr "Une croix dans la barre la masque ; avec l’option de mémoire le visiteur ne la revoit pas pendant la durée choisie (script anti-clignotement dans l’en-tête). Repli et fermeture sont indépendants : une barre repliée est toujours là, une barre fermée a disparu."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:346
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1106
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1755
msgid "Desktop"
msgstr "Ordinateur"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:350
msgid "From 768 px: a fixed bar aligned on the site container. The height follows the number of headline lines. The close button and its memory are set on the Mobile tab, under Closing: they apply to both devices."
msgstr "À partir de 768 px : une barre fixe alignée sur le conteneur du site. La hauteur suit le nombre de lignes du titre. Le bouton de fermeture et sa mémoire se règlent dans l’onglet Mobile, sous Fermeture : ils valent pour les deux appareils."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:355
msgid "Headlines, one after another (desktop)"
msgstr "Les titres, l’un après l’autre (ordinateur)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:356
msgid "How several headlines take their turn. Marquee always uses a single line; rotate and manual honour the line count. The rotate interval is on the Mobile tab and serves both."
msgstr "Comment plusieurs titres se succèdent. Le défilement continu tient toujours sur une seule ligne ; la rotation et le mode manuel respectent le nombre de lignes. L’intervalle de rotation est dans l’onglet Mobile et sert aux deux."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:360
msgid "When the bar appears (desktop)"
msgstr "Moment d’apparition de la barre (ordinateur)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:361
msgid "Desktop decides for itself; mobile has the same choice on its own tab. The article body selector, shared by both, is on the Mobile tab."
msgstr "L’ordinateur décide pour lui-même ; le mobile a le même choix sur son propre onglet. Le sélecteur du corps de l’article, commun aux deux, est dans l’onglet Mobile."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:365
msgid "Folding (desktop)"
msgstr "Repli (ordinateur)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:366
msgid "Off, the bar simply stays put. On, it slides out of view and leaves a small tab to bring it back; the two settings below then decide when."
msgstr "Désactivé, la barre reste simplement en place. Activé, elle glisse hors de vue et laisse un petit onglet pour la rappeler ; les deux réglages ci-dessous décident alors quand."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:373
msgid "Colours"
msgstr "Couleurs"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:376
msgid "Palette"
msgstr "Palette"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:377
msgid "One palette for desktop and mobile. The theme red is only used for the label pill: that is what catches the eye."
msgstr "Une seule palette ordinateur / mobile. Le rouge du thème n’est utilisé que pour la pastille : c’est lui qui attire l’œil."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:382
msgid "Dedicated mobile palette"
msgstr "Palette mobile dédiée"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:383
msgid "Optional: other colours under 768 px."
msgstr "Optionnel : d’autres couleurs sous 768 px."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:390
msgid "Advanced"
msgstr "Avancé"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:393
msgid "Jannah fixed elements"
msgstr "Éléments fixes de Jannah"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:394
msgid "The bar exposes its visible height as --hprnb-offset on <body> (with body.hprnb-is-collapsed, body.hprnb-kbd and the hprnb:state event). With this option the theme's \"go to top\" button, \"Check also\" box and reading position indicator sit above the bar and follow its collapse. Nothing in the theme is modified."
msgstr "La barre expose sa hauteur visible dans --hprnb-offset sur <body> (avec body.hprnb-is-collapsed, body.hprnb-kbd et l’évènement hprnb:state). Avec cette option, le bouton « remonter », la boîte « Voir aussi » et l’indicateur de lecture du thème se placent au-dessus de la barre et suivent son repli. Rien n’est modifié dans le thème."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:399
msgid "Technical"
msgstr "Technique"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:424
msgid "Enable the news bar"
msgstr "Activer la barre d’actualités"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:425
msgid "Display the bar on the public site."
msgstr "Afficher la barre sur le site public."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:430
msgid "Label"
msgstr "Label"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:431
msgid "Short text shown next to the headlines. Leave empty to hide the label."
msgstr "Texte court affiché à côté des titres. Laissez vide pour masquer le label."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:437
msgid "Label position"
msgstr "Position du label"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:439
msgid "Start of the line"
msgstr "Début de ligne"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:440
msgid "End of the line"
msgstr "Fin de ligne"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:442
msgid "\"End\" is the right side in left-to-right languages and the left side in right-to-left languages."
msgstr "« Fin » correspond à la droite dans les langues de gauche à droite et à la gauche dans les langues de droite à gauche."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:447
msgid "Time window"
msgstr "Fenêtre temporelle"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:448
msgid "Sliding window ending now: at 16:20 with 24 hours, posts published since yesterday 16:20 are eligible. Minutes: 1–1440, hours: 1–720, days: 1–30."
msgstr "Fenêtre glissante se terminant maintenant : à 16:20 avec 24 heures, les articles publiés depuis la veille 16:20 sont éligibles. Minutes : 1–1440, heures : 1–720, jours : 1–30."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:454
msgid "Categories"
msgstr "Catégories"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:455
msgid "No selection means every category."
msgstr "Aucune sélection signifie toutes les catégories."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:460
msgid "Maximum number of posts"
msgstr "Nombre maximum d’articles"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:465
msgid "Order"
msgstr "Ordre"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:467
msgid "Newest first"
msgstr "Du plus récent au plus ancien"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:468
msgid "Oldest first"
msgstr "Du plus ancien au plus récent"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:475
msgid "Excluded categories"
msgstr "Catégories exclues"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:481
msgid "Tags"
msgstr "Étiquettes"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:482
msgid "When at least one tag is selected, only posts having one of these tags are eligible."
msgstr "Lorsqu’au moins une étiquette est sélectionnée, seuls les articles portant l’une de ces étiquettes sont éligibles."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:487
msgid "Never list these articles in the bar"
msgstr "Ne jamais lister ces articles dans la barre"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:488
msgid "Comma-separated post IDs that must never appear in the bar."
msgstr "Identifiants d’articles séparés par des virgules qui ne doivent jamais apparaître dans la barre."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:493
msgid "Background colour"
msgstr "Couleur de fond"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:498
msgid "Text colour"
msgstr "Couleur du texte"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:504
msgid "Label background colour"
msgstr "Couleur de fond du label"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:509
msgid "Label text colour"
msgstr "Couleur du texte du label"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:515
msgid "Link hover colour"
msgstr "Couleur des liens au survol"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:520
msgid "Accent colour"
msgstr "Couleur d’accent"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:521
msgid "Progress line and link hover underline (the theme red by default)."
msgstr "Ligne de progression et soulignement au survol (rouge du thème par défaut)."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:526
msgid "Font size (px)"
msgstr "Taille de police (px)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:531
msgid "Height (px)"
msgstr "Hauteur (px)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:532
msgid "32 to 56 px; 40 px recommended. With the label on its own row or several headline lines the bar grows as needed."
msgstr "32 à 56 px ; 40 px recommandés. Avec le label sur sa ligne ou plusieurs lignes de titre, la barre grandit autant que nécessaire."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:537
msgid "Align on the site container"
msgstr "Aligner sur le conteneur du site"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:538
msgid "Same maximum width and gutter as the article (Jannah container: 1230 px, 15 px)."
msgstr "Même largeur maximale et même gouttière que l’article (conteneur Jannah : 1230 px, 15 px)."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:543
msgid "Container width (px)"
msgstr "Largeur du conteneur (px)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:549
msgid "Gutter (px)"
msgstr "Gouttière (px)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:555
msgid "z-index"
msgstr "z-index"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:560
msgid "Layout"
msgstr "Disposition"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:562
msgid "Reserve — pushes the page content up so the bar never covers it (default)"
msgstr "Réserve — décale le contenu de la page pour que la barre ne le recouvre jamais (défaut)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:563
msgid "Overlay — floats over the page; may cover a fixed element of the theme or of another plugin"
msgstr "Superposition — flotte au-dessus de la page ; peut recouvrir un élément fixe du thème ou d’une autre extension"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:569
msgid "Source size of the images"
msgstr "Taille source des images"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:571
msgid "An existing WordPress image size, loaded for both profiles; no new size is generated. The displayed size is set per device under Desktop & mobile."
msgstr "Une taille d’image WordPress existante, chargée pour les deux profils ; aucune nouvelle taille n’est générée. La taille affichée se règle par appareil sous Ordinateur et mobile."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:576
msgid "Separator"
msgstr "Séparateur"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:577
msgid "Show a separator between headlines."
msgstr "Afficher un séparateur entre les titres."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:582
msgid "Separator character"
msgstr "Caractère de séparation"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:591
msgid "Separator after the last post"
msgstr "Séparateur après le dernier article"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:592
msgid "Show the separator after the last post (continuous loop)."
msgstr "Afficher le séparateur après le dernier article (boucle continue)."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:593
msgid "Makes the last → first junction identical to every other junction, for example when the marquee wraps. Only applies when the separator is enabled."
msgstr "Rend la jonction dernier → premier identique à toutes les autres jonctions, par exemple lorsque le défilement continu reboucle. Ne s’applique que si le séparateur est activé."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:599
msgid "Relative time"
msgstr "Heure relative"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:600
msgid "Show \"2 hours ago\" after each headline (refreshed every minute in the browser)."
msgstr "Afficher « il y a 2 heures » après chaque titre (actualisé chaque minute dans le navigateur)."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:605
msgid "Relative time limit (hours)"
msgstr "Limite de l’heure relative (heures)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:606
msgid "Beyond this age the absolute date is shown instead."
msgstr "Au-delà de cet âge, la date absolue est affichée à la place."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:611
msgid "Label placement"
msgstr "Position du label"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:613
msgid "In front of the headline, on the same line (default on desktop)"
msgstr "Devant le titre, sur la même ligne (défaut sur ordinateur)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:614
msgid "On its own row above the headline"
msgstr "Sur sa propre ligne, au-dessus du titre"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:620
#: horizon-press-news-bar/includes/admin/class-settings-page.php:690
msgid "Label style"
msgstr "Style du label"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:622
#: horizon-press-news-bar/includes/admin/class-settings-page.php:693
msgid "Block — full-height label in the label colours"
msgstr "Bandeau — label sur toute la hauteur, aux couleurs du label"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:623
#: horizon-press-news-bar/includes/admin/class-settings-page.php:692
msgid "Pill — small rounded uppercase badge"
msgstr "Pastille — petit badge arrondi en capitales"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:624
#: horizon-press-news-bar/includes/admin/class-settings-page.php:694
msgid "Hidden"
msgstr "Masqué"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:630
#: horizon-press-news-bar/includes/admin/class-settings-page.php:700
msgid "Live dot"
msgstr "Point « en direct »"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:631
#: horizon-press-news-bar/includes/admin/class-settings-page.php:701
msgid "Show a small pulsing dot in front of the label text."
msgstr "Afficher un petit point pulsant devant le texte du label."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:636
#: horizon-press-news-bar/includes/admin/class-settings-page.php:706
msgid "Counter"
msgstr "Compteur"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:637
#: horizon-press-news-bar/includes/admin/class-settings-page.php:707
msgid "Show \"2/8\" next to the label (rotate mode)."
msgstr "Afficher « 2/8 » à côté du label (mode rotation)."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:642
#: horizon-press-news-bar/includes/admin/class-settings-page.php:712
msgid "Headline lines"
msgstr "Lignes de titre"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:644
msgid "Number of lines a headline may take; the bar height follows (marquee always uses one line)."
msgstr "Nombre de lignes qu’un titre peut occuper ; la hauteur de la barre suit (le marquee reste sur une ligne)."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:650
#: horizon-press-news-bar/includes/admin/class-settings-page.php:785
msgid "Image"
msgstr "Image"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:651
#: horizon-press-news-bar/includes/admin/class-settings-page.php:786
msgid "Show the featured image next to each headline."
msgstr "Afficher l’image mise en avant à côté de chaque titre."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:656
#: horizon-press-news-bar/includes/admin/class-settings-page.php:791
msgid "Image position"
msgstr "Position de l’image"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:658
#: horizon-press-news-bar/includes/admin/class-settings-page.php:793
msgid "Before the headline"
msgstr "Avant le titre"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:659
#: horizon-press-news-bar/includes/admin/class-settings-page.php:794
msgid "After the headline"
msgstr "Après le titre"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:666
#: horizon-press-news-bar/includes/admin/class-settings-page.php:801
msgid "Image size (px)"
msgstr "Taille de l’image (px)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:667
msgid "16 to 80 px, square. The bar grows if the image is taller than the headline lines."
msgstr "16 à 80 px, carrée. La barre grandit si l’image dépasse la hauteur des lignes de titre."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:673
#: horizon-press-news-bar/includes/admin/class-settings-page.php:744
msgid "Progress line"
msgstr "Ligne de progression"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:674
#: horizon-press-news-bar/includes/admin/class-settings-page.php:745
msgid "Show a thin progress line along the top edge until the next headline (rotate mode)."
msgstr "Afficher une fine ligne de progression le long du bord supérieur jusqu’au titre suivant (mode rotation)."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:681
msgid "\"Explore More\" card (default) — a label row, then the picture at the left and the headline on up to three lines, the close button in a tab above the corner"
msgstr "Carte « Explore More » (défaut) — une ligne d’étiquette, puis l’image à gauche et le titre sur trois lignes au plus, le bouton de fermeture dans un onglet au-dessus du coin"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:682
msgid "Flowing bar — the label opens the headline, which runs across the width of the screen"
msgstr "Barre fluide — l’étiquette ouvre le titre, qui court sur la largeur de l’écran"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:683
msgid "Label row above the headline"
msgstr "Ligne d’étiquette au-dessus du titre"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:684
msgid "Label in front of the headline, on one line"
msgstr "Étiquette devant le titre, sur une ligne"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:714
msgid "Number of lines a headline may take; the height shown beside this field follows it. Marquee always uses one line, and the discover card stops at three."
msgstr "Nombre de lignes qu’un titre peut occuper ; la hauteur affichée à côté de ce champ le suit. Le défilement continu tient sur une ligne, et la carte Découvrir s’arrête à trois."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:720
msgid "Card height (px)"
msgstr "Hauteur de la carte (px)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:721
msgid "64 to 96 px; 76 px = 12 + two lines of 26 + 12. Floating label only; grows with the number of lines."
msgstr "64 à 96 px ; 76 px = 12 + deux lignes de 26 + 12. Label flottant uniquement ; grandit avec le nombre de lignes."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:726
msgid "Mobile font size (px)"
msgstr "Taille de police mobile (px)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:731
msgid "Mobile ticker mode"
msgstr "Mode de défilement mobile"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:733
msgid "Rotate — one headline at a time (recommended)"
msgstr "Rotation — un titre à la fois (recommandé)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:734
msgid "Same as desktop"
msgstr "Identique à l’ordinateur"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:735
msgid "Static list"
msgstr "Liste statique"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:736
msgid "Marquee"
msgstr "Défilement continu (marquee)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:737
msgid "Manual — previous / next buttons"
msgstr "Manuel — boutons précédent / suivant"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:739
msgid "Rotate and marquee always come with the Pause / Play button and respect reduced-motion preferences."
msgstr "La rotation et le défilement continu s’accompagnent toujours du bouton Pause / Lecture et respectent la préférence de mouvement réduit."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:750
msgid "Swipe"
msgstr "Balayage"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:751
msgid "Swipe left or right to move between headlines (rotate mode)."
msgstr "Balayer vers la gauche ou la droite pour passer d’un titre à l’autre (mode rotation)."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:756
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1208
msgid "Fold the bar away"
msgstr "Replier la barre"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:757
msgid "Turn folding on for mobile. Off, the bar keeps its full height and the settings below do nothing. Needs a design other than \"Label in front of the headline\"."
msgstr "Active le repli sur mobile. Désactivé, la barre garde toute sa hauteur et les réglages ci-dessous ne font rien. Nécessite un design autre que « Étiquette devant le titre »."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:762
msgid "Collapsed strip"
msgstr "Bandeau replié"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:764
msgid "Label and the first line of the headline"
msgstr "Pastille et première ligne du titre"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:765
msgid "Label only"
msgstr "Pastille seule"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:772
msgid "Landing mid-page"
msgstr "Arrivée en milieu de page"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:773
msgid "Start collapsed when the page opens further than 120 px down (anchor, back navigation)."
msgstr "Commencer replié quand la page s’ouvre au-delà de 120 px (ancre, retour arrière)."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:779
msgid "Keyboard open"
msgstr "Clavier ouvert"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:780
msgid "Slide the bar away while a form field is active; bring it back on blur."
msgstr "Effacer la barre tant qu’un champ de formulaire est actif ; la ramener à la perte du focus."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:802
msgid "16 to 80 px, square. Never taller than the headline block, so the card keeps its height."
msgstr "16 à 80 px, carrée. Jamais plus haute que le bloc de titre : la carte garde sa hauteur."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:808
msgid "Mobile — when it folds"
msgstr "Mobile — quand elle se replie"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:810
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1216
msgid "While scrolling down past the threshold; it unfolds again when scrolling up"
msgstr "Pendant le défilement vers le bas au-delà du seuil ; elle se déplie de nouveau en remontant"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:811
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1217
msgid "As soon as the threshold is passed, and it stays folded while below it"
msgstr "Dès que le seuil est franchi, et elle reste repliée tant qu’on est en dessous"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:812
msgid "Always folded — the reader opens it with a tap"
msgstr "Toujours repliée — le lecteur l’ouvre d’une pression"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:813
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1219
msgid "Follows the reading — open when reading on past the point where it appeared, folded on any scroll back up inside the article, never folded once the article is over"
msgstr "Suit la lecture — ouverte quand on poursuit au-delà du point où elle est apparue, repliée à toute remontée dans l’article, jamais repliée une fois l’article terminé"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:820
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1226
msgid "Collapse threshold (px)"
msgstr "Seuil de repli (px)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:821
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1227
msgid "0 to 800 px of scrolling; 120 px by default. Ignored when the bar is always folded or follows the reading."
msgstr "De 0 à 800 px de défilement ; 120 px par défaut. Ignoré lorsque la barre est toujours repliée ou suit la lecture."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:827
msgid "Buttons placement"
msgstr "Emplacement des boutons"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:829
msgid "Inside the bar"
msgstr "Dans la barre"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:830
msgid "Floating just above the bar — the headline then takes the whole width"
msgstr "Flottants juste au-dessus de la barre — le titre occupe alors toute la largeur"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:836
msgid "Pause button"
msgstr "Bouton Pause"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:837
msgid "Show the Pause / Play button on mobile."
msgstr "Afficher le bouton Pause / Lecture sur mobile."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:842
#: horizon-press-news-bar/includes/admin/class-settings-page.php:955
msgid "Close button"
msgstr "Bouton fermer"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:843
msgid "Show the close button on mobile (it must also be enabled under Appearing & folding → Closing)."
msgstr "Afficher le bouton de fermeture sur mobile (il doit aussi être activé sous Apparition et repli → Fermeture)."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:848
msgid "Buttons"
msgstr "Boutons"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:850
msgid "Stacked — close above pause (one column, more room for the headline)"
msgstr "Empilés — fermer au-dessus de pause (une seule colonne, plus de place pour le titre)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:851
msgid "Side by side"
msgstr "Côte à côte"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:857
msgid "Pulsing label"
msgstr "Pastille clignotante"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:859
msgid "A few beats when the bar arrives (recommended)"
msgstr "Quelques battements à l’arrivée de la barre (recommandé)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:860
msgid "Always — the pill breathes like a button"
msgstr "Toujours — la pastille respire comme un bouton"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:861
msgid "Only in the collapsed strip"
msgstr "Seulement dans le bandeau replié"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:862
msgid "Never"
msgstr "Jamais"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:864
msgid "Ignored when the visitor asks for reduced motion."
msgstr "Ignoré si le visiteur demande un mouvement réduit."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:869
msgid "Image in the collapsed strip"
msgstr "Image dans le bandeau replié"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:870
msgid "Keep the image at the end of the strip, resized so it never exceeds one line."
msgstr "Garder l’image en fin de bandeau, redimensionnée pour ne jamais dépasser une ligne."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:876
msgid "Compact label with an image"
msgstr "Pastille compacte avec une image"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:877
msgid "Shrink the pill to its red dot when an image is shown, so the headline keeps the width."
msgstr "Réduire la pastille à son point rouge quand une image est affichée, pour laisser la largeur au titre."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:883
msgid "Mobile separator"
msgstr "Séparateur mobile"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:884
msgid "Show the separator between headlines on mobile too (static, marquee and manual modes)."
msgstr "Afficher aussi le séparateur entre les titres sur mobile (modes statique, marquee et manuel)."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:889
msgid "Mobile colours"
msgstr "Couleurs mobiles"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:890
msgid "Use a dedicated mobile palette (below) instead of the desktop colours."
msgstr "Utiliser une palette mobile dédiée (ci-dessous) à la place des couleurs ordinateur."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:895
msgid "Mobile background colour"
msgstr "Couleur de fond mobile"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:901
msgid "Mobile text colour"
msgstr "Couleur du texte mobile"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:908
msgid "Mobile accent colour"
msgstr "Couleur d’accent mobile"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:909
msgid "Label pill, live dot and progress line."
msgstr "Pastille du label, point « en direct » et ligne de progression."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:915
msgid "Mobile label text colour"
msgstr "Couleur du texte du label mobile"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:921
msgid "Ticker"
msgstr "Défilement"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:922
msgid "Animate the headlines. Marquee and rotate always come with a keyboard-accessible Pause / Play button and stop when the visitor prefers reduced motion."
msgstr "Animer les titres. Les modes défilement continu et rotation s’accompagnent toujours d’un bouton Pause / Lecture accessible au clavier et s’arrêtent lorsque le visiteur préfère réduire les animations."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:927
msgid "Ticker mode"
msgstr "Mode de défilement"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:929
msgid "Marquee — continuous scrolling"
msgstr "Défilement continu (marquee)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:930
msgid "Rotate — one headline at a time"
msgstr "Rotation — un titre à la fois"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:931
msgid "Manual — previous / next buttons, no automatic motion"
msgstr "Manuel — boutons précédent / suivant, aucun mouvement automatique"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:937
msgid "Marquee speed (px/s)"
msgstr "Vitesse du défilement (px/s)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:938
msgid "10 to 80 px per second; 30 recommended (20 px/s made a 20-headline loop last four minutes)."
msgstr "10 à 80 px par seconde ; 30 recommandés (à 20 px/s, un tour de 20 titres durait quatre minutes)."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:943
msgid "Rotate interval (ms)"
msgstr "Intervalle de rotation (ms)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:944
msgid "3000 to 12000 ms (3 to 12 seconds) between two headlines."
msgstr "3000 à 12000 ms (3 à 12 secondes) entre deux titres."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:949
msgid "Pause on hover"
msgstr "Pause au survol"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:950
msgid "Extra comfort option; the Pause / Play button remains the accessible control."
msgstr "Option de confort supplémentaire ; le bouton Pause / Lecture reste la commande accessible."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:956
msgid "Let visitors close the bar."
msgstr "Permettre aux visiteurs de fermer la barre."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:961
msgid "Remember closing"
msgstr "Mémoriser la fermeture"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:962
msgid "Keep the bar closed for the duration below (stored in the browser localStorage, no cookie)."
msgstr "Garder la barre fermée pendant la durée ci-dessous (stockée dans le localStorage du navigateur, sans cookie)."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:967
msgid "Closing duration (hours)"
msgstr "Durée de fermeture (heures)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:972
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1000
msgid "When the bar appears"
msgstr "Moment d’apparition de la barre"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:974
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1002
msgid "Right away, with the page"
msgstr "Immédiatement, avec la page"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:975
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1003
msgid "After a scroll distance — recommended on articles: the opening of the page stays clear"
msgstr "Après une distance de défilement — recommandé sur les articles : le début de la page reste dégagé"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:976
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1004
msgid "After a share of the page has been read"
msgstr "Après qu’une partie de la page a été lue"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:977
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1005
msgid "Near the end of the page (90 %)"
msgstr "Vers la fin de la page (90 %)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:978
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1006
msgid "Before the end of the article — as soon as the chosen paragraph, counted from the end, comes into view"
msgstr "Avant la fin de l’article — dès que le paragraphe choisi, compté depuis la fin, apparaît à l’écran"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:979
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1007
msgid "Smart — recommended on articles: the end of the article, a real scroll back up, or a reader who got deep into it"
msgstr "Intelligent — recommandé sur les articles : la fin de l’article, une vraie remontée, ou un lecteur bien avancé"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:981
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1009
msgid "Until then no space is reserved and the bar stays out of view; once it appears it stays. \"Before the end\" and Smart measure the article body, not the page; Smart fires once on whichever signal comes first."
msgstr "Jusque-là aucun espace n’est réservé et la barre reste hors de vue ; une fois apparue, elle reste. « Avant la fin » et Intelligent mesurent le corps de l’article, pas la page ; Intelligent se déclenche une fois, au premier signal venu."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:986
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1014
msgid "Appearance threshold"
msgstr "Seuil d’apparition"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:988
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1016
msgid "Pixels of scrolling, or percentage of the page for the share option. 400 px is a good start on an article."
msgstr "Pixels de défilement, ou pourcentage de la page pour l’option proportionnelle. 400 px est un bon point de départ sur un article."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:993
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1021
msgid "Paragraphs before the end"
msgstr "Paragraphes avant la fin"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:995
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1023
msgid "2 = the second-to-last paragraph of the article. Counted from the end of the article body, so a larger number shows the bar earlier. 1 to 30."
msgstr "2 = l’avant-dernier paragraphe de l’article. Compté depuis la fin du corps de l’article : un nombre plus grand affiche la barre plus tôt. De 1 à 30."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1028
msgid "Article body selector"
msgstr "Sélecteur du corps de l’article"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1029
msgid "Optional, and shared by both devices. A CSS selector for the editorial body of an article, when the theme needs one. Left empty, the usual containers are tried in turn (.entry-content, .post-content, .article-content, .wp-block-post-content…). Never the footer, the comments or what follows the article."
msgstr "Facultatif, et commun aux deux appareils. Un sélecteur CSS du corps éditorial d’un article, quand le thème en a besoin. Laissé vide, les conteneurs usuels sont essayés tour à tour (.entry-content, .post-content, .article-content, .wp-block-post-content…). Jamais le pied de page, les commentaires ni ce qui suit l’article."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1034
msgid "Mobile — article read before a scroll up counts (%)"
msgstr "Mobile — article lu avant qu’une remontée compte (%)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1040
msgid "Mobile — active reading time before it counts (s)"
msgstr "Mobile — temps de lecture actif avant qu’elle compte (s)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1046
msgid "Mobile — upward scrolling that shows intent (px)"
msgstr "Mobile — remontée qui marque l’intention (px)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1052
msgid "Mobile — fallback: article read (%)"
msgstr "Mobile — repli : article lu (%)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1058
msgid "Mobile — fallback: active reading time (s)"
msgstr "Mobile — repli : temps de lecture actif (s)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1064
msgid "Desktop — article read before a scroll up counts (%)"
msgstr "Ordinateur — article lu avant qu’une remontée compte (%)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1070
msgid "Desktop — active reading time before it counts (s)"
msgstr "Ordinateur — temps de lecture actif avant qu’elle compte (s)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1076
msgid "Desktop — upward scrolling that shows intent (px)"
msgstr "Ordinateur — remontée qui marque l’intention (px)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1082
msgid "Desktop — fallback: article read (%)"
msgstr "Ordinateur — repli : article lu (%)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1088
msgid "Desktop — fallback: active reading time (s)"
msgstr "Ordinateur — repli : temps de lecture actif (s)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1094
msgid "Accent edge"
msgstr "Liseré d’accent"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1095
msgid "Draw a 2 px line of the accent colour along the top edge; the rotation progress fills that same edge."
msgstr "Tracer un trait de 2 px de la couleur d’accent sur le bord supérieur ; la progression de la rotation remplit ce même trait."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1100
msgid "Theme fixed elements"
msgstr "Éléments fixes du thème"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1101
msgid "Move the Jannah \"go to top\" button, the \"Check also\" box and the reading position indicator above the bar (they follow the collapse)."
msgstr "Décaler le bouton « remonter », la boîte « Voir aussi » et l’indicateur de lecture de Jannah au-dessus de la barre (ils suivent le repli)."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1107
msgid "Show the bar on screens of 768 px and wider."
msgstr "Afficher la barre sur les écrans de 768 px et plus."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1113
msgid "Show the bar on screens narrower than 768 px (CSS only, no device detection)."
msgstr "Afficher la barre sur les écrans de moins de 768 px (CSS uniquement, sans détection d’appareil)."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1120
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1165
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1260
msgid "Front page"
msgstr "Page d’accueil"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1121
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1166
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1261
msgid "Blog home"
msgstr "Page des articles"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1122
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1167
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1262
msgid "Single post"
msgstr "Article seul"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1123
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1168
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1263
msgid "Page"
msgstr "Page"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1124
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1169
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1264
msgid "Category archive"
msgstr "Archive de catégorie"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1125
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1170
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1265
msgid "Tag archive"
msgstr "Archive d’étiquette"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1126
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1171
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1266
msgid "Other archives"
msgstr "Autres archives"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1127
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1172
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1267
msgid "Search results"
msgstr "Résultats de recherche"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1128
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1173
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1268
msgid "404 page"
msgstr "Page 404"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1130
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1175
msgid "Narrows the page types above for this device only. Untick everything here and the bar never shows on this device."
msgstr "Restreint les types de pages ci-dessus pour cet appareil uniquement. Décochez tout ici et la barre ne s’affiche jamais sur cet appareil."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1135
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1180
msgid "Placement"
msgstr "Positionnement"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1137
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1182
msgid "Pinned to the bottom of the screen"
msgstr "Fixée en bas de l’écran"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1138
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1183
msgid "Inside the article, between the paragraphs"
msgstr "Dans l’article, entre les paragraphes"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1140
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1185
msgid "Inside the article the bar becomes a block of the page: full width, no reserved space, no collapsing. On any page without paragraphs it falls back to the bottom of the screen."
msgstr "Dans l’article, la barre devient un bloc de la page : pleine largeur, aucun espace réservé, aucun repli. Sur une page sans paragraphe, elle revient en bas de l’écran."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1145
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1190
msgid "Where in the article"
msgstr "Où dans l’article"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1147
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1192
msgid "Before a paragraph"
msgstr "Avant un paragraphe"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1148
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1193
msgid "After a paragraph"
msgstr "Après un paragraphe"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1149
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1194
msgid "Before the last paragraphs"
msgstr "Avant les derniers paragraphes"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1156
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1201
msgid "Paragraph number"
msgstr "Numéro du paragraphe"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1157
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1202
msgid "1 to 30. Counted from the start of the article, or from its end for the last option. A shorter article places the bar at its end."
msgstr "De 1 à 30. Compté depuis le début de l’article, ou depuis sa fin pour la dernière option. Un article plus court place la barre à sa fin."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1209
msgid "Turn folding on for desktop. Off, the bar stays put and the two settings below do nothing."
msgstr "Active le repli sur ordinateur. Désactivé, la barre reste en place et les deux réglages ci-dessous ne font rien."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1214
msgid "Desktop — when it folds"
msgstr "Ordinateur — quand elle se replie"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1218
msgid "Always folded — the reader opens it from the tab"
msgstr "Toujours repliée — le lecteur l’ouvre depuis l’onglet"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1233
msgid "Card picture width (px)"
msgstr "Largeur de l’image de la carte (px)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1234
msgid "72 to 160 px, in a 16:9 frame; 132 px by default, as on the reference (132 × 74). The headline takes the rest of the line."
msgstr "De 72 à 160 px, dans un cadre 16:9 ; 132 px par défaut, comme sur la maquette (132 × 74). Le titre prend le reste de la ligne."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1240
msgid "Floating card"
msgstr "Carte flottante"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1241
msgid "Detach the card 8 px from the edges, with rounded corners and a shadow. Off, it runs edge to edge with square corners, like the reference."
msgstr "Détache la carte de 8 px des bords, avec des coins arrondis et une ombre. Désactivé, elle va d’un bord à l’autre avec des coins droits, comme la maquette."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1247
msgid "Where the bar may appear"
msgstr "Où la barre peut apparaître"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1249
msgid "Everywhere on the site"
msgstr "Partout sur le site"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1250
msgid "Only the page types ticked below"
msgstr "Uniquement les types de pages cochés ci-dessous"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1252
msgid "To show the bar on single articles only, pick the second option and leave \"Single post\" as the only tick."
msgstr "Pour n’afficher la barre que sur les pages d’article, choisissez la deuxième option et ne laissez cochée que « Article seul »."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1270
msgid "The bar is never shown in wp-admin, feeds, embeds, previews, the login page, sitemaps, AMP pages, REST, AJAX or cron requests."
msgstr "La barre n’est jamais affichée dans wp-admin, les flux, les contenus embarqués, les prévisualisations, la page de connexion, les plans de site, les pages AMP ni les requêtes REST, AJAX ou cron."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1275
msgid "Never show the bar on these pages"
msgstr "Ne jamais afficher la barre sur ces pages"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1276
msgid "Comma-separated IDs of pages or posts on which the bar must not appear."
msgstr "Identifiants de pages ou d’articles, séparés par des virgules, sur lesquels la barre ne doit pas apparaître."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1281
msgid "Render mode"
msgstr "Mode de rendu"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1283
msgid "Hybrid (recommended) — server rendering plus a conditional REST refresh when a page cache served a stale bar"
msgstr "Hybride (recommandé) — rendu serveur plus un rafraîchissement REST conditionnel lorsqu’un cache de page a servi une barre obsolète"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1284
msgid "PHP — server rendering only, no freshness check (diagnostics or sites without a long page cache)"
msgstr "PHP — rendu serveur uniquement, sans contrôle de fraîcheur (diagnostic ou sites sans cache de page long)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1290
msgid "Server cache TTL (seconds)"
msgstr "Durée du cache serveur (secondes)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1291
msgid "30 to 600 seconds. Kept short because a post can leave the window without any WordPress event."
msgstr "30 à 600 secondes. Volontairement court, car un article peut sortir de la fenêtre sans aucun événement WordPress."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1296
msgid "Stale threshold (seconds)"
msgstr "Seuil d’obsolescence (secondes)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1297
msgid "Hybrid mode: a server-rendered bar older than this triggers at most one REST request per page load."
msgstr "Mode hybride : une barre rendue par le serveur plus ancienne que ce seuil déclenche au plus une requête REST par chargement de page."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1302
msgid "Automatic display"
msgstr "Affichage automatique"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1303
msgid "Insert the bar automatically in the footer of eligible pages."
msgstr "Insérer automatiquement la barre dans le pied de page des pages éligibles."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1308
msgid "Shortcode"
msgstr "Shortcode"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1309
msgid "Allow [hprnb_news_bar]. Only one bar is ever rendered per page."
msgstr "Autoriser [hprnb_news_bar]. Une seule barre est rendue par page."

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1314
msgid "Uninstall"
msgstr "Désinstallation"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1315
msgid "Delete the plugin settings when the plugin is uninstalled. Posts, media and terms are never touched."
msgstr "Supprimer les réglages de l’extension lors de sa désinstallation. Les articles, médias et termes ne sont jamais touchés."

#. translators: %d: number of lines.
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1329
msgid "%d line"
msgid_plural "%d lines"
msgstr[0] "%d ligne"
msgstr[1] "%d lignes"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1373
msgid "Other"
msgstr "Autres"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1397
msgid "Enable"
msgstr "Activer"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1404
msgid "Presets:"
msgstr "Préréglages :"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1405
msgid "Dark + red pill (recommended)"
msgstr "Sombre + pastille rouge (recommandé)"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1406
msgid "Solid red"
msgstr "Rouge plein"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1429
msgid "Advanced filters"
msgstr "Filtres avancés"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1434
msgid "Typical set-ups"
msgstr "Cas d’usage courants"

#. translators: %d: bar height in pixels.
#: horizon-press-news-bar/includes/admin/class-settings-page.php:1466
msgid "Bar height: %d px"
msgstr "Hauteur de la barre : %d px"

#: horizon-press-news-bar/includes/admin/class-settings-page.php:1592
